{
  "manifest_version": 3,
  "name": "HammerIT lite (ChatGPT trial)",
  "version": "0.15.0",
  "description": "Trinity's trial copy of HammerIT lite for chatgpt.com. Same panel and the same HammerIT app on this computer.",
  "host_permissions": [
    "http://127.0.0.1:4333/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "version_name": "0.15.0 ChatGPT trial"
}